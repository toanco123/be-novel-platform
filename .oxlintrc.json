{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "warn",
    "no-console": "error",
    "typescript/no-extraneous-class": [
      "warn",
      {
        "allowWithDecorator": true
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "postgres",
            "message": "Chỉ src/infra/database được dùng postgres.js; nơi khác inject DB (Drizzle)."
          },
          {
            "name": "drizzle-orm/postgres-js",
            "message": "Chỉ src/infra/database được tạo client Drizzle; nơi khác inject DB."
          },
          {
            "name": "nestjs-zod",
            "importNames": ["createZodDto"],
            "message": "Dùng createZodDto của @/core/http/zod-dto (sửa schema nullable trong Swagger)."
          }
        ]
      }
    ],
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["_OPENAPI_METADATA_FACTORY"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/infra/database/**", "test/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/core/http/zod-dto.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "ignorePatterns": ["dist", "coverage", "node_modules"]
}
