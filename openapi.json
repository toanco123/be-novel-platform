  "info": {
    "title": "Novel Platform API",
    "description": "Backend của nền tảng đọc truyện chữ.\n\n**Thử nhanh:** gọi `POST /v1/auth/register` hoặc `/v1/auth/login` → access token tự điền vào nút\n**Authorize** (giữ lại khi tải lại trang) → gọi các route có ổ khóa. Hết hạn (15 phút) thì gọi\n`POST /v1/auth/refresh` (cookie refresh token đã có sẵn trên trình duyệt).\n\n**Response thành công** có dạng `{ data, meta: { requestId } }`.\n\n**Tên trường:** body / query nhận cả camelCase lẫn snake_case (`displayName` hay `display_name`); response luôn camelCase.\n\n**Lỗi** luôn có dạng `{ code, message, details?, requestId }`; client hiển thị lời theo `code`.",
    "version": "0.0.13",
    "contact": {}
  },
  "tags": [
    {
      "name": "auth",
      "description": "Đăng ký, đăng nhập, refresh token, đăng xuất"
    },
    {
      "name": "me",
      "description": "Tài khoản của người đang đăng nhập"
    },
    {
      "name": "health",
      "description": "Kiểm tra app còn chạy (cho Docker / load balancer)"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Access token"
      }
    },
    "schemas": {
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "linh@example.com"
          },
          "displayName": {
            "type": "string",
            "example": "Linh"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin"
            ],
            "example": "user"
          },
          "emailVerified": {
            "type": "boolean",
            "description": "false cho tới khi xác nhận email (phần 5)"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "avatarUrl",
          "role",
          "emailVerified",
          "createdAt"
        ]
      },
      "AuthSessionDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/MeDto"
          },
          "accessToken": {
            "type": "string",
            "description": "JWT gửi kèm mọi request: Authorization: Bearer <accessToken>",
            "example": "eyJhbGciOiJFUzI1NiIsImtpZCI6ImRldiIsInR5cCI6IkpXVCJ9..."
          },
          "expiresIn": {
            "type": "integer",
            "description": "Access token còn hiệu lực (giây)",
            "example": 900
          },
          "refreshToken": {
            "type": "string",
            "description": "Chỉ có khi gửi header X-Client: mobile; web nhận trong cookie HttpOnly"
          }
        },
        "required": [
          "user",
          "accessToken",
          "expiresIn"
        ]
      },
      "ResponseMetaDto": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "description": "Id của request (trùng header x-request-id), gửi kèm khi báo lỗi",
            "example": "0b8e7f7e-2d51-4d1a-a1f3-5f0f6a8c9d22"
          }
        },
        "required": [
          "requestId"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "linh@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72,
            "example": "mat-khau-bi-mat"
          },
          "displayName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50,
            "example": "Linh"
          }
        },
        "required": [
          "email",
          "password",
          "displayName"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "bad_request",
          "validation_failed",
          "unauthenticated",
          "invalid_token",
          "invalid_credentials",
          "token_reused",
          "account_banned",
          "email_taken",
          "forbidden",
          "not_found",
          "conflict",
          "payload_too_large",
          "rate_limited",
          "internal_error",
          "timeout",
          "service_unavailable"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "example": "not_found",
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              }
            ]
          },
          "message": {
            "type": "string",
            "description": "Tiếng Anh, cho dev đọc; client hiển thị lời theo code"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          },
          "requestId": {
            "type": "string",
            "example": "0b8e7f7e-2d51-4d1a-a1f3-5f0f6a8c9d22"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "linh@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "example": "mat-khau-bi-mat"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "maxLength": 256,
            "description": "Chỉ mobile gửi; web để trống, token nằm trong cookie refresh_token"
          }
        }
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50,
            "example": "Linh Nguyễn",
            "description": "Tên hiển thị, 2–50 ký tự sau khi bỏ khoảng trắng ở hai đầu"
          }
        },
        "required": [
          "displayName"
        ]
      }
    }
  }
}
