    "/v1/auth/refresh": {
      "post": {
        "description": "Refresh token lấy từ body (mobile) hoặc cookie (web). Token cũ hết hiệu lực ngay; gửi lại token cũ thì cả phiên bị thu hồi (`token_reused`).",
        "operationId": "AuthController_refresh_v1",
        "parameters": [
          {
            "name": "X-Client",
            "in": "header",
            "description": "`mobile`: refresh token trả trong body thay vì cookie",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "mobile"
              ]
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenDto"
              },
              "examples": {
                "web": {
                  "summary": "Web: để trống, dùng cookie refresh_token",
                  "value": {}
                },
                "mobile": {
                  "summary": "Mobile: gửi refresh token",
                  "value": {
                    "refreshToken": "<refreshToken>"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/AuthSessionDto"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/ResponseMetaDto"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "code: `unauthenticated`, `invalid_token`, `token_reused`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                },
                "examples": {
                  "unauthenticated": {
                    "summary": "unauthenticated",
                    "value": {
                      "code": "unauthenticated",
                      "message": "Authentication required",
                      "requestId": "0b8e7f7e-2d51-4d1a-a1f3-5f0f6a8c9d22"
                    }
                  },
                  "invalid_token": {
                    "summary": "invalid_token",
                    "value": {
                      "code": "invalid_token",
                      "message": "Token is invalid or expired",
                      "requestId": "0b8e7f7e-2d51-4d1a-a1f3-5f0f6a8c9d22"
                    }
                  },
                  "token_reused": {
                    "summary": "token_reused",
                    "value": {
                      "code": "token_reused",
                      "message": "Refresh token was already used",
                      "requestId": "0b8e7f7e-2d51-4d1a-a1f3-5f0f6a8c9d22"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "code: `account_banned`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                },
                "examples": {
                  "account_banned": {
                    "summary": "account_banned",
                    "value": {
                      "code": "account_banned",
                      "message": "This account is banned",
                      "details": {
                        "bannedUntil": "2026-12-31T00:00:00.000Z"
                      },
                      "requestId": "0b8e7f7e-2d51-4d1a-a1f3-5f0f6a8c9d22"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Lấy access token mới (xoay vòng refresh token)",
        "tags": [
          "auth"
        ]
      }
    },
