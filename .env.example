# Môi trường: development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Origin được gọi API (ngăn bằng dấu phẩy), vd web dev và production
CORS_ORIGINS=http://localhost:3000,https://web-novel-platform-gules.vercel.app
# Số proxy đứng trước app (Cloudflare, load balancer...) để lấy đúng IP người dùng; 0 nếu chạy thẳng
TRUST_PROXY_HOPS=0
# Bật trang tài liệu API /docs và /openapi.json
SWAGGER_ENABLED=true

# Postgres của docker-compose (npm run db:up); cổng 5433 để không đụng Postgres khác trên máy
DATABASE_URL=postgres://novel:novel@localhost:5433/novel
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000

# Redis của docker-compose (cổng 6380): rate limit, hàng đợi job
REDIS_URL=redis://localhost:6380
# Chặn spam thô toàn API: tối đa THROTTLE_LIMIT request mỗi THROTTLE_TTL_SECONDS giây (theo user hoặc IP)
THROTTLE_LIMIT=300
THROTTLE_TTL_SECONDS=60

# Khóa ký access token ES256 (npm run keys:generate). Dev để trống: app tự sinh khóa tạm mỗi lần chạy
# (token cũ mất hiệu lực khi khởi động lại). Production bắt buộc.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=dev
JWT_ISSUER=novel-api
JWT_AUDIENCE=novel-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Cookie refresh token chỉ gửi qua HTTPS; để trống: bật ở production, tắt ở dev (http://localhost)
COOKIE_SECURE=

# Gửi mail qua SMTP. Dev: Mailpit của docker-compose (xem thư ở http://localhost:8025).
# Production: SMTP của nhà cung cấp (Resend, SES, Brevo...), vd smtps://user:pass@smtp.example.com:465
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Web Truyện <no-reply@novel.local>
# Gốc của link trong email (trang xác nhận email, đặt lại mật khẩu của web)
APP_WEB_URL=http://localhost:3000
# Secret Cloudflare Turnstile (captcha của form đăng ký, đăng nhập...); trống thì tắt captcha
TURNSTILE_SECRET=

# Đăng nhập mạng xã hội. API_PUBLIC_URL dựng redirect_uri khai báo ở Google / Facebook:
# <API_PUBLIC_URL>/v1/auth/oauth/google/callback, .../facebook/callback
API_PUBLIC_URL=http://localhost:4000
# Tiền tố redirect_to được phép ngoài APP_WEB_URL (csv), vd deep link của app: webtruyen://
OAUTH_REDIRECT_URLS=
# Thiếu thì tắt provider đó
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Bundle id của app iOS (csv), là aud của id token Apple
APPLE_CLIENT_IDS=
